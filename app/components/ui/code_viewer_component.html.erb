<div class="rounded-xl bg-[#080C14] border border-slate-800 overflow-hidden font-mono text-xs shadow-2xl" data-controller="clipboard">
  <!-- Code viewer header bar -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-slate-900/90 border-b border-slate-800/80">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
      <span class="ml-2 font-medium text-slate-300 text-xs tracking-tight"><%= title %></span>
      <span class="ml-2 px-1.5 py-0.5 rounded bg-slate-800 text-[10px] text-slate-400"><%= payload_size_label %></span>
    </div>

    <% if copyable %>
      <!-- Hidden textarea storing raw text for clipboard controller -->
      <textarea data-clipboard-target="source" class="hidden"><%= raw_json_string %></textarea>

      <button
        type="button"
        data-action="click->clipboard#copy"
        data-clipboard-target="button"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 transition text-[11px] font-sans font-medium focus:outline-hidden focus:ring-1 focus:ring-indigo-500 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span data-clipboard-target="label">Copy JSON</span>
      </button>
    <% end %>
  </div>

  <!-- Code area with line numbers -->
  <div class="overflow-x-auto overflow-y-auto <%= max_height %> p-4 leading-relaxed select-text">
    <table class="border-collapse w-full">
      <tbody>
        <% syntax_highlighted_lines.each_with_index do |line_html, idx| %>
          <tr class="hover:bg-slate-800/30 transition-colors">
            <td class="pr-4 text-right text-slate-600 select-none font-mono text-[11px] w-8 align-top">
              <%= idx + 1 %>
            </td>
            <td class="font-mono text-slate-200 text-xs whitespace-pre">
              <%= line_html %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
