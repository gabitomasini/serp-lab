<div class="flex-1 flex overflow-hidden min-h-0 bg-[#09090b]">
  <!-- Left Column: Request Builder (Fixed 420px) -->
  <aside class="w-[420px] min-w-[420px] border-r border-[#27272a] flex flex-col h-full bg-[#09090b]">
    <!-- Panel Header -->
    <div class="px-4 py-3 border-b border-[#27272a] flex items-center gap-2 shrink-0">
      <div class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></div>
      <span class="text-[11px] font-semibold text-[#94a3b8] tracking-widest uppercase">
        REQUEST BUILDER
      </span>
    </div>

    <!-- Form Builder -->
    <%= form_with url: playground_path, method: :post, data: { turbo_frame: "playground_results", controller: "request-builder" }, class: "flex-1 flex flex-col min-h-0" do |f| %>
      <div class="scroll-area flex-1 p-4 space-y-4">
        <!-- Engine Selector -->
        <div>
          <label class="block text-[11px] font-semibold text-[#94a3b8] mb-1.5 tracking-wider uppercase">
            ENGINE
          </label>
          <div class="flex bg-[#18181b] border border-[#27272a] rounded-lg p-0.5 gap-0.5">
            <% [["google", "Google"], ["shopping", "Shopping"], ["youtube", "YouTube"]].each do |(val, label)| %>
              <label class="flex-1 text-center cursor-pointer">
                <input
                  type="radio"
                  name="engine"
                  value="<%= val %>"
                  data-request-builder-target="engineRadio"
                  data-action="change->request-builder#engineChanged"
                  class="peer sr-only"
                  <%= 'checked' if (@engine == val || (@engine == 'google_shopping' && val == 'shopping') || (@engine.blank? && val == 'google')) %>
                />
                <span class="block py-1.5 px-2.5 rounded-md text-xs transition-all text-[#71717a] peer-checked:bg-[#27272a] peer-checked:text-[#fafafa] peer-checked:font-medium select-none">
                  <%= label %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Query Input -->
        <div>
          <label for="query" class="block text-[11px] font-semibold text-[#94a3b8] mb-1.5 tracking-wider uppercase">
            QUERY (q)
          </label>
          <input
            type="text"
            name="query"
            id="query"
            value="<%= @query || 'site:github.com/trending' %>"
            placeholder="site:github.com/trending"
            data-request-builder-target="queryInput"
            data-action="input->request-builder#inputChanged"
            class="w-full px-2.5 py-1.5 bg-[#18181b] border border-[#27272a] rounded-md text-[#fafafa] text-xs font-mono outline-none focus:border-[#3b82f6] transition-colors"
          />
        </div>

        <!-- Location Select -->
        <div>
          <label for="country" class="block text-[11px] font-semibold text-[#94a3b8] mb-1.5 tracking-wider uppercase">
            LOCATION (gl)
          </label>
          <div class="relative">
            <select
              name="country"
              id="country"
              data-request-builder-target="countrySelect"
              data-action="change->request-builder#inputChanged"
              class="w-full px-2.5 py-1.5 bg-[#18181b] border border-[#27272a] rounded-md text-[#fafafa] text-xs outline-none appearance-none cursor-pointer pr-7 focus:border-[#3b82f6] transition-colors"
            >
              <option value="us" <%= 'selected' if @country == 'us' %>>United States (US)</option>
              <option value="gb" <%= 'selected' if @country == 'gb' %>>United Kingdom (GB)</option>
              <option value="de" <%= 'selected' if @country == 'de' %>>Germany (DE)</option>
              <option value="fr" <%= 'selected' if @country == 'fr' %>>France (FR)</option>
              <option value="jp" <%= 'selected' if @country == 'jp' %>>Japan (JP)</option>
              <option value="ca" <%= 'selected' if @country == 'ca' %>>Canada (CA)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-[#71717a]">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Device Selector -->
        <div>
          <label class="block text-[11px] font-semibold text-[#94a3b8] mb-1.5 tracking-wider uppercase">
            DEVICE
          </label>
          <div class="flex bg-[#18181b] border border-[#27272a] rounded-lg p-0.5 gap-0.5">
            <label class="flex-1 text-center cursor-pointer">
              <input type="radio" name="device" value="desktop" class="peer sr-only" checked />
              <span class="block py-1.5 px-2.5 rounded-md text-xs transition-all text-[#71717a] peer-checked:bg-[#27272a] peer-checked:text-[#fafafa] peer-checked:font-medium select-none">
                ⊞ Desktop
              </span>
            </label>
            <label class="flex-1 text-center cursor-pointer">
              <input type="radio" name="device" value="mobile" class="peer sr-only" />
              <span class="block py-1.5 px-2.5 rounded-md text-xs transition-all text-[#71717a] peer-checked:bg-[#27272a] peer-checked:text-[#fafafa] peer-checked:font-medium select-none">
                ◻ Mobile
              </span>
            </label>
          </div>
        </div>

        <!-- Simulate Error Toggle -->
        <div class="pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-[#71717a] hover:text-[#a1a1aa] transition-colors">
            <input
              type="checkbox"
              name="force_error"
              value="1"
              class="w-3.5 h-3.5 rounded bg-[#18181b] border-[#27272a] text-[#f59e0b] focus:ring-0 focus:ring-offset-0 cursor-pointer"
            />
            <span class="text-[11px] font-mono">Simulate Rate Limit (HTTP 429)</span>
          </label>
        </div>

        <!-- Code Preview Component com Abas (curl / nodejs / python) e Copy -->
        <div
          data-controller="tabs"
          data-tabs-default-tab-value="curl"
          data-tabs-active-classes-value='["text-[#fafafa]", "border-[#fafafa]"]'
          data-tabs-inactive-classes-value='["text-[#71717a]", "border-transparent"]'
        >
          <label class="block text-[11px] font-semibold text-[#94a3b8] mb-1.5 tracking-wider uppercase">
            CODE PREVIEW
          </label>
          <div class="border border-[#27272a] rounded-lg overflow-hidden bg-[#0d0d0f]" data-controller="clipboard">
            <div class="flex items-center bg-[#18181b] border-b border-[#27272a] px-1">
              <button
                type="button"
                data-tabs-target="tab"
                data-tab-target-name="curl"
                data-action="click->tabs#change"
                class="px-2.5 py-1.5 text-[11px] font-medium transition cursor-pointer text-[#fafafa] border-b border-[#fafafa] -mb-[1px]"
              >cURL</button>
              <button
                type="button"
                data-tabs-target="tab"
                data-tab-target-name="nodejs"
                data-action="click->tabs#change"
                class="px-2.5 py-1.5 text-[11px] font-medium transition cursor-pointer text-[#71717a] border-b border-transparent -mb-[1px]"
              >Node.js</button>
              <button
                type="button"
                data-tabs-target="tab"
                data-tab-target-name="python"
                data-action="click->tabs#change"
                class="px-2.5 py-1.5 text-[11px] font-medium transition cursor-pointer text-[#71717a] border-b border-transparent -mb-[1px]"
              >Python</button>

              <div class="flex-1"></div>

              <button
                type="button"
                data-action="click->clipboard#copy"
                data-clipboard-target="button"
                class="px-2 py-1 text-[10px] font-mono text-[#52525b] hover:text-[#a1a1aa] transition cursor-pointer"
              >
                <span data-clipboard-target="label">copy</span>
              </button>
            </div>

            <!-- Painel cURL -->
            <div data-tabs-target="panel" data-tab-panel-name="curl">
              <pre class="m-0 p-3 text-[11px] leading-relaxed font-mono text-[#e4e4e7] max-h-40 overflow-y-auto whitespace-pre-wrap break-all"><code data-clipboard-target="source" data-request-builder-target="curlCode">curl -G "https://api.serplab.io/api/v1/search" \
  -d "engine=<%= @engine || 'google' %>" \
  -d "q=<%= @query || 'site:github.com/trending' %>" \
  -d "gl=<%= @country || 'us' %>" \
  -H "Authorization: Bearer $SERPLAB_KEY"</code></pre>
            </div>

            <!-- Painel Node.js -->
            <div data-tabs-target="panel" data-tab-panel-name="nodejs" class="hidden">
              <pre class="m-0 p-3 text-[11px] leading-relaxed font-mono text-[#e4e4e7] max-h-40 overflow-y-auto whitespace-pre-wrap break-all"><code data-request-builder-target="nodeCode">import SerpLab from 'serplab-js';

const client = new SerpLab(process.env.SERPLAB_KEY);

const results = await client.search({
  engine: '<%= @engine || "google" %>',
  q: '<%= @query || "site:github.com/trending" %>',
  gl: '<%= @country || "us" %>',
});

console.log(results);</code></pre>
            </div>

            <!-- Painel Python -->
            <div data-tabs-target="panel" data-tab-panel-name="python" class="hidden">
              <pre class="m-0 p-3 text-[11px] leading-relaxed font-mono text-[#e4e4e7] max-h-40 overflow-y-auto whitespace-pre-wrap break-all"><code data-request-builder-target="pythonCode">import serplab

client = serplab.Client(api_key=os.environ['SERPLAB_KEY'])

results = client.search(
    engine='<%= @engine || "google" %>',
    q='<%= @query || "site:github.com/trending" %>',
    gl='<%= @country || "us" %>',
)

print(results)</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="p-3 border-t border-[#27272a] bg-[#09090b] shrink-0">
        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-md bg-[#10b981] hover:bg-[#059669] active:bg-[#047857] text-white text-xs font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer"
        >
          <span>Send Request</span>
        </button>
      </div>
    <% end %>
  </aside>

  <!-- Right Column: Response Panel via Turbo Frame -->
  <main class="flex-1 flex flex-col min-w-0 bg-[#09090b] overflow-hidden">
    <%= render "results" %>
  </main>
</div>
