<%= turbo_frame_tag "playground_results", class: "flex-1 flex flex-col min-h-0 overflow-hidden" do %>
  <div class="flex-1 flex flex-col min-w-0 bg-[#09090b] overflow-hidden" data-controller="tabs" data-tabs-default-tab-value="parsed">
    <!-- Response Meta Header -->
    <div class="px-4 py-2.5 border-b border-[#27272a] flex items-center gap-2 flex-wrap shrink-0">
      <!-- Status Pill -->
      <% is_ok = (@status_code || 200) == 200 %>
      <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium border <%= is_ok ? 'bg-[#022c22] text-[#10b981] border-[#064e3b]' : 'bg-[#1c1100] text-[#f59e0b] border-[#78350f]' %>">
        <%= @status_code || 200 %> <%= is_ok ? 'OK' : 'Error' %>
      </span>

      <!-- Engine Tag -->
      <% active_engine = (@engine.to_s == "shopping" || @engine.to_s == "google_shopping") ? "google_shopping" : (@engine.to_s == "youtube" ? "youtube" : "google") %>
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#18181b] border border-[#27272a]">
        <span class="text-[#52525b] text-[10px] tracking-wider font-sans">engine</span>
        <span class="font-mono text-[#a1a1aa] text-[11px]"><%= active_engine %></span>
      </div>

      <!-- Meta Tag: Latency -->
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#18181b] border border-[#27272a]">
        <span class="text-[#52525b] text-[10px] tracking-wider font-sans">latency</span>
        <span class="font-mono text-[#a1a1aa] text-[11px]"><%= @latency_ms || 142 %> ms</span>
      </div>

      <!-- Meta Tag: Size -->
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#18181b] border border-[#27272a]">
        <span class="text-[#52525b] text-[10px] tracking-wider font-sans">size</span>
        <span class="font-mono text-[#a1a1aa] text-[11px]">
          <%= @payload ? sprintf("%.1f KB", @payload.to_json.bytesize / 1024.0) : "38.4 KB" %>
        </span>
      </div>

      <div class="flex-1"></div>

      <!-- Copy JSON Button -->
      <div data-controller="clipboard" data-clipboard-feedback-text-value="Copied!">
        <textarea data-clipboard-target="source" class="sr-only"><%= @payload.is_a?(Hash) ? JSON.pretty_generate(@payload) : @payload.to_s %></textarea>
        <button
          type="button"
          data-action="click->clipboard#copy"
          data-clipboard-target="button"
          class="flex items-center gap-1.5 px-2.5 py-1 bg-[#18181b] border border-[#27272a] rounded-md text-[#a1a1aa] text-[11px] hover:text-[#fafafa] transition cursor-pointer"
        >
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none">
            <rect x="4" y="1" width="7" height="8" rx="1" stroke="currentColor" stroke-width="1.2"/>
            <path d="M1 4v6a1 1 0 001 1h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span data-clipboard-target="label">Copy JSON</span>
        </button>
      </div>
    </div>

    <!-- View Switcher Tabs -->
    <div class="border-b border-[#27272a] flex px-3 gap-0.5 shrink-0">
      <button
        type="button"
        data-tabs-target="tab"
        data-tab-target-name="parsed"
        data-action="click->tabs#change"
        class="px-3 py-2 text-xs font-medium cursor-pointer transition border-b-2 border-[#10b981] text-[#f1f5f9] -mb-[1px]"
      >
        Parsed View
      </button>
      <button
        type="button"
        data-tabs-target="tab"
        data-tab-target-name="tree"
        data-action="click->tabs#change"
        class="px-3 py-2 text-xs font-medium cursor-pointer transition border-b-2 border-transparent text-[#71717a] hover:text-[#a1a1aa] -mb-[1px]"
      >
        Tree JSON
      </button>
      <button
        type="button"
        data-tabs-target="tab"
        data-tab-target-name="raw"
        data-action="click->tabs#change"
        class="px-3 py-2 text-xs font-medium cursor-pointer transition border-b-2 border-transparent text-[#71717a] hover:text-[#a1a1aa] -mb-[1px]"
      >
        Raw Payload
      </button>
    </div>

    <!-- Content Panels Container -->
    <div class="scroll-area flex-1 p-4 min-h-0 overflow-y-auto">
      <!-- 1. Parsed View (Polymorphic by Engine) -->
      <div data-tabs-target="panel" data-tab-panel-name="parsed">
        <% if @status_code == 429 %>
          <div class="p-6 rounded-lg bg-[#1c1100] border border-[#78350f] text-[#f59e0b] max-w-lg mx-auto text-left space-y-2">
            <div class="flex items-center gap-2 text-sm font-semibold">
              <svg class="w-4 h-4 text-[#f59e0b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>HTTP 429: Rate Limit Exceeded</span>
            </div>
            <p class="text-xs text-[#d4d4d8] leading-relaxed">
              <%= @payload.is_a?(Hash) ? (@payload["message"] || @payload[:message]) : "Rate limit quota exceeded. Please wait before retrying." %>
            </p>
          </div>

        <% elsif active_engine == "google_shopping" %>
          <!-- GOOGLE SHOPPING VIEW -->
          <% shopping_items = (@payload.is_a?(Hash) && (@payload["shopping_results"] || @payload[:shopping_results])) || [] %>
          <div class="text-[11px] text-[#52525b] mb-3 font-mono">
            shopping_results [<%= shopping_items.length %>]
          </div>

          <% if shopping_items.any? %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
              <% shopping_items.each do |p| %>
                <%
                  p_title = p["title"] || p[:title]
                  p_link = p["product_link"] || p[:product_link] || p["link"] || p[:link] || "#"
                  p_price = p["price"] || p[:price]
                  p_orig = p["original_price"] || p[:original_price]
                  p_seller = p["seller"] || p[:seller]
                  p_rating = p["rating"] || p[:rating]
                  p_reviews = p["reviews"] || p[:reviews]
                  p_thumb = p["thumbnail"] || p[:thumbnail]
                  p_tag = p["tag"] || p[:tag]
                %>
                <div class="group flex flex-col bg-[#18181b] border border-[#27272a] rounded-lg overflow-hidden hover:border-[#3f3f46] transition-all">
                  <!-- Thumbnail Container -->
                  <div class="relative h-44 bg-[#141416] flex items-center justify-center p-3 overflow-hidden border-b border-[#27272a]">
                    <% if p_thumb.present? %>
                      <img src="<%= p_thumb %>" alt="<%= p_title %>" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-200" loading="lazy" />
                    <% else %>
                      <div class="text-[#52525b] font-mono text-xs">No Image</div>
                    <% end %>

                    <% if p_tag.present? %>
                      <span class="absolute top-2 left-2 bg-[#022c22] text-[#10b981] border border-[#064e3b] text-[10px] font-mono font-medium px-2 py-0.5 rounded">
                        <%= p_tag %>
                      </span>
                    <% end %>
                  </div>

                  <!-- Details -->
                  <div class="p-3.5 flex-1 flex flex-col justify-between space-y-2.5">
                    <div>
                      <!-- Seller -->
                      <div class="flex items-center gap-1.5 text-[11px] text-[#71717a] mb-1">
                        <svg class="w-3 h-3 text-[#52525b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span class="font-mono truncate"><%= p_seller || "Merchant" %></span>
                      </div>

                      <!-- Title -->
                      <a href="<%= p_link %>" target="_blank" rel="noopener noreferrer" class="text-xs font-medium text-[#fafafa] line-clamp-2 hover:underline leading-snug">
                        <%= p_title %>
                      </a>
                    </div>

                    <!-- Price & Rating -->
                    <div class="pt-2 border-t border-[#1f1f22] flex items-center justify-between">
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-sm font-bold font-mono text-[#10b981]"><%= p_price %></span>
                        <% if p_orig.present? %>
                          <span class="text-[11px] font-mono text-[#71717a] line-through"><%= p_orig %></span>
                        <% end %>
                      </div>

                      <% if p_rating.present? %>
                        <div class="flex items-center gap-1 text-[11px] font-mono text-[#f59e0b]">
                          <span>★</span>
                          <span><%= p_rating %></span>
                          <% if p_reviews.present? %>
                            <span class="text-[#52525b] text-[10px]">(<%= p_reviews %>)</span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="py-12 text-center text-[#71717a] text-xs font-mono">
              No shopping results returned for this query.
            </div>
          <% end %>

        <% elsif active_engine == "youtube" %>
          <!-- YOUTUBE VIDEO VIEW -->
          <% videos = (@payload.is_a?(Hash) && (@payload["videos"] || @payload[:videos] || @payload["video_results"] || @payload[:video_results])) || [] %>
          <div class="text-[11px] text-[#52525b] mb-3 font-mono">
            video_results [<%= videos.length %>]
          </div>

          <% if videos.any? %>
            <div class="space-y-3">
              <% videos.each do |v| %>
                <%
                  v_title = v["title"] || v[:title]
                  v_link = v["link"] || v[:link] || (v["id"] ? "https://www.youtube.com/watch?v=#{v["id"]}" : "#")
                  v_length = v["length"] || v[:length] || v["duration"] || v[:duration]
                  v_channel = v["channel"] || v[:channel]
                  v_channel_title = (v_channel.is_a?(Hash) && (v_channel["title"] || v_channel[:title])) || v_channel.to_s
                  v_views = v["views"] || v[:views]
                  v_pub = v["published_time"] || v[:published_time]
                  v_desc = v["description"] || v[:description] || v["snippet"] || v[:snippet]
                  v_thumb_obj = v["thumbnail"] || v[:thumbnail]
                  v_thumb_url = if v_thumb_obj.is_a?(Hash)
                    v_thumb_obj["static"] || v_thumb_obj[:static] || v_thumb_obj["rich"] || v_thumb_obj[:rich]
                  else
                    v_thumb_obj.to_s
                  end
                %>
                <div class="p-3 bg-[#18181b] border border-[#27272a] rounded-lg hover:border-[#3f3f46] transition-colors flex flex-col sm:flex-row gap-3.5">
                  <!-- Thumbnail (16:9 fixed width on desktop) -->
                  <div class="relative w-full sm:w-48 sm:h-28 shrink-0 bg-[#0d0d0f] rounded overflow-hidden aspect-video sm:aspect-auto">
                    <% if v_thumb_url.present? %>
                      <img src="<%= v_thumb_url %>" alt="<%= v_title %>" class="w-full h-full object-cover" loading="lazy" />
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center text-[#52525b] font-mono text-xs">YouTube Video</div>
                    <% end %>

                    <% if v_length.present? %>
                      <span class="absolute bottom-1.5 right-1.5 bg-black/85 text-white font-mono text-[10px] px-1.5 py-0.5 rounded font-medium">
                        <%= v_length %>
                      </span>
                    <% end %>
                  </div>

                  <!-- Details -->
                  <div class="flex-1 flex flex-col justify-between min-w-0">
                    <div>
                      <a href="<%= v_link %>" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[#fafafa] hover:text-[#3b82f6] hover:underline line-clamp-2 leading-snug">
                        <%= v_title %>
                      </a>

                      <div class="flex items-center gap-2 mt-1.5 text-[11px] font-mono text-[#a1a1aa]">
                        <span class="text-[#fafafa] font-medium truncate"><%= v_channel_title %></span>
                        <span>•</span>
                        <% if v_views.present? %>
                          <span><%= v_views.is_a?(Numeric) ? number_to_human(v_views, units: { thousand: 'K', million: 'M' }) : v_views %> views</span>
                          <span>•</span>
                        <% end %>
                        <% if v_pub.present? %>
                          <span class="text-[#71717a]"><%= v_pub %></span>
                        <% end %>
                      </div>

                      <% if v_desc.present? %>
                        <p class="text-[11px] text-[#71717a] mt-1.5 line-clamp-2 leading-relaxed">
                          <%= v_desc %>
                        </p>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="py-12 text-center text-[#71717a] text-xs font-mono">
              No video results returned for this query.
            </div>
          <% end %>

        <% else %>
          <!-- GOOGLE SEARCH VIEW -->
          <div class="flex gap-4">
            <!-- Organic Results -->
            <div class="flex-1 min-w-0">
              <% organic_results = (@payload.is_a?(Hash) && (@payload["organic_results"] || @payload[:organic_results])) || [] %>
              <div class="text-[11px] text-[#52525b] mb-2 font-mono">
                organic_results [<%= organic_results.length %>]
              </div>

              <% if organic_results.any? %>
                <% organic_results.each do |r| %>
                  <%
                    r_title = r["title"] || r[:title]
                    r_link = r["link"] || r[:link] || "#"
                    r_snippet = r["snippet"] || r[:snippet]
                    r_displayed = r["displayed_link"] || r[:displayed_link] || (URI.parse(r_link).host rescue "google.com")
                    r_domain = (URI.parse(r_link).host rescue nil) || "google.com"
                  %>
                  <div class="py-3 border-b border-[#1f1f22] last:border-0">
                    <div class="flex items-center gap-1.5 mb-1">
                      <img
                        src="https://www.google.com/s2/favicons?domain=<%= r_domain %>&sz=16"
                        class="w-3.5 h-3.5 opacity-75 shrink-0"
                        alt=""
                        loading="lazy"
                      />
                      <span class="text-[11px] text-[#10b981] tracking-tight leading-none font-sans truncate">
                        <%= r_displayed %>
                      </span>
                    </div>
                    <a
                      href="<%= r_link %>"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#f8fafc] text-[13px] font-medium hover:underline hover:decoration-slate-400/50 block mb-1 leading-snug transition-colors"
                    >
                      <%= r_title %>
                    </a>
                    <p class="m-0 text-[#8b8b96] text-xs leading-relaxed">
                      <%= r_snippet %>
                    </p>
                  </div>
                <% end %>
              <% else %>
                <div class="py-12 text-center text-[#71717a] text-xs font-mono">
                  No organic results returned for this query.
                </div>
              <% end %>
            </div>

            <!-- Knowledge Panel (220px) -->
            <% if @payload.is_a?(Hash) && (@payload["knowledge_graph"] || @payload[:knowledge_graph]).present? %>
              <% kg = @payload["knowledge_graph"] || @payload[:knowledge_graph] %>
              <%
                kg_title = kg["title"] || kg[:title]
                kg_type = kg["type"] || kg[:type]
              %>
              <aside class="w-[220px] shrink-0">
                <div class="text-[11px] text-[#52525b] mb-2 font-mono">
                  knowledge_graph
                </div>
                <div class="border border-[#27272a] rounded-lg bg-[#18181b] overflow-hidden">
                  <div class="h-16 bg-gradient-to-br from-[#1e3a5f] to-[#1a2744] flex items-center justify-center border-b border-[#27272a]">
                    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" fill="#1d4ed8" opacity="0.4"/>
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="#93c5fd"/>
                    </svg>
                  </div>
                  <div class="p-3">
                    <div class="text-[13px] font-semibold text-[#fafafa] mb-0.5"><%= kg_title %></div>
                    <div class="text-[11px] text-[#71717a] mb-2.5"><%= kg_type %></div>
                    <div class="space-y-1">
                      <% kg.except("title", :title, "type", :type, "header_images", :header_images).each do |k, v| %>
                        <% next if v.is_a?(Array) || v.is_a?(Hash) %>
                        <div class="flex justify-between gap-2 py-1 border-t border-[#1f1f22] text-[11px]">
                          <span class="text-[#71717a] shrink-0"><%= k.to_s.humanize %></span>
                          <span class="text-[#d4d4d8] text-right truncate"><%= v %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </aside>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- 2. Tree JSON View (Nativo com <details> aninhados recursivamente) -->
      <div data-tabs-target="panel" data-tab-panel-name="tree" class="hidden">
        <div class="bg-[#0d0d0f] border border-[#27272a] rounded-md p-3 font-mono text-[11px] space-y-1">
          <% render_tree = ->(key, val, depth = 0) do %>
            <% if val.is_a?(Hash) || val.is_a?(Array) %>
              <details class="group" style="padding-left: <%= depth * 14 %>px;" <%= 'open' if depth == 0 %>>
                <summary class="flex items-center gap-1.5 py-0.5 px-1 hover:bg-zinc-800/80 rounded cursor-pointer list-none select-none">
                  <span class="text-[#52525b] text-[10px] w-2.5 group-open:rotate-90 transition-transform">▸</span>
                  <span class="text-[#93c5fd] font-semibold"><%= key %></span>
                  <span class="text-[#52525b] text-[11px]">
                    <%= val.is_a?(Array) ? "[#{val.size}]" : "{…}" %>
                  </span>
                </summary>
                <div>
                  <% if val.is_a?(Hash) %>
                    <% val.each { |k, v| render_tree.call(k, v, depth + 1) } %>
                  <% else %>
                    <% val.each_with_index { |item, idx| render_tree.call(idx, item, depth + 1) } %>
                  <% end %>
                </div>
              </details>
            <% else %>
              <div class="flex items-center gap-1 py-0.5 px-1 hover:bg-zinc-800/80 rounded" style="padding-left: <%= (depth * 14) + 14 %>px;">
                <span class="text-[#93c5fd]"><%= key %></span>
                <span class="text-[#52525b]">:</span>
                <span class="<%= val.is_a?(String) ? 'text-[#86efac]' : (val.is_a?(Numeric) ? 'text-[#fbbf24]' : 'text-[#a78bfa]') %>">
                  <%= val.is_a?(String) ? "\"#{val}\"" : val.to_s %>
                </span>
              </div>
            <% end %>
          <% end %>

          <% if @payload.is_a?(Hash) %>
            <% @payload.each { |k, v| render_tree.call(k, v, 0) } %>
          <% end %>
        </div>
      </div>

      <!-- 3. Raw Payload View -->
      <div data-tabs-target="panel" data-tab-panel-name="raw" class="hidden">
        <pre class="m-0 bg-[#0d0d0f] border border-[#27272a] rounded-md p-3.5 overflow-x-auto text-[11px] leading-relaxed font-mono text-[#a1a1aa] whitespace-pre"><code><%= @payload.is_a?(Hash) ? JSON.pretty_generate(@payload) : @payload.to_s %></code></pre>
      </div>
    </div>
  </div>
<% end %>
