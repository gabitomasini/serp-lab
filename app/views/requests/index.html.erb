<div class="scroll-area flex-1 p-6 overflow-y-auto">
  <div class="space-y-6 max-w-7xl mx-auto">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-800">
    <div>
      <h1 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        Request Observability Log
      </h1>
      <p class="text-xs text-slate-400 mt-1">
        High-density audit log of all SERP requests with execution latencies and status codes.
      </p>
    </div>

    <!-- Live stats summary pills -->
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-subtle"></span>
        <%= @ok_count %> successful
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <%= @error_count %> rate limited
      </span>
    </div>
  </div>

  <!-- Status Filter Toolbar -->
  <div class="flex items-center justify-between gap-4">
    <div class="inline-flex p-1 rounded-xl bg-slate-950 border border-slate-800 shadow-inner">
      <%= link_to requests_path(status: "all"),
            data: { turbo_frame: "requests_table" },
            class: "px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-colors #{@current_status == 'all' ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'}" do %>
        All (<%= @all_count %>)
      <% end %>

      <%= link_to requests_path(status: "200"),
            data: { turbo_frame: "requests_table" },
            class: "px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-colors #{@current_status == '200' ? 'bg-emerald-600/30 text-emerald-300 border border-emerald-500/40 shadow-xs' : 'text-slate-400 hover:text-slate-200'}" do %>
        200 OK (<%= @ok_count %>)
      <% end %>

      <%= link_to requests_path(status: "429"),
            data: { turbo_frame: "requests_table" },
            class: "px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-colors #{@current_status == '429' ? 'bg-amber-600/30 text-amber-300 border border-amber-500/40 shadow-xs' : 'text-slate-400 hover:text-slate-200'}" do %>
        429 Rate Limited (<%= @error_count %>)
      <% end %>
    </div>

    <div class="text-xs font-mono text-slate-500 hidden sm:block">
      Turbo Frame filtered
    </div>
  </div>

  <!-- Request Table Frame -->
  <%= turbo_frame_tag "requests_table" do %>
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden shadow-xl backdrop-blur-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-950/70 border-b border-slate-800 text-[11px] font-mono uppercase tracking-wider text-slate-400">
              <th scope="col" class="px-4 py-3 font-semibold">Status</th>
              <th scope="col" class="px-4 py-3 font-semibold">Engine</th>
              <th scope="col" class="px-4 py-3 font-semibold">Geo</th>
              <th scope="col" class="px-4 py-3 font-semibold">Query</th>
              <th scope="col" class="px-4 py-3 font-semibold">Latency</th>
              <th scope="col" class="px-4 py-3 font-semibold text-right">Timestamp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            <% if @requests.any? %>
              <% @requests.each do |req| %>
                <%= render Ui::RequestRowComponent.new(request: req) %>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-500 text-xs font-mono">
                  No requests found for status "<%= @current_status %>".
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Table Footer -->
      <div class="px-4 py-3 bg-slate-950/40 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-slate-400">
        <span>Showing <%= @requests.size %> entries</span>
        <span class="text-slate-500">Auto-persisted in SQLite (WAL mode)</span>
      </div>
    </div>
  <% end %>
</div>
</div>
